# API kök adresi. Boş bırakılırsa '/api' kullanılır ve geliştirmede Vite proxy'si üzerinden backend'e gider.
# Canlıda frontend ile API aynı site altında sunulmalıdır (refresh token cookie'si SameSite=Strict).
VITE_API_URL=

# Geliştirme sunucusunun '/api' isteklerini yönlendireceği backend adresi
VITE_API_PROXY_TARGET=https://localhost:7206
